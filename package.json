{
  "name": "dsh-theme-studio-art",
  "version": "1.3.4",
  "description": "Twenty original literary & artistic themes for DeepSeek Harness (DSH), each with light/dark palettes, 116 design tokens and animated wallpapers; no third-party artwork.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-theme-studio contributors",
  "icon": "icon.png",
  "homepage": "https://github.com/YOUR_GITHUB_USER/dsh-theme-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USER/dsh-theme-studio.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USER/dsh-theme-studio/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "wallpaper",
    "appearance",
    "ink-wash",
    "chinese-style"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "icon.svg",
    "locale/*.json",
    "wallpapers/*.jpg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "PUBLISHING.md",
    "screenshots.json",
    "assets/*.png",
    "assets/screenshots/*",
    "design/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
